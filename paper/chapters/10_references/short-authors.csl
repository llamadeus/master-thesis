<?xml version="1.0" encoding="UTF-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US">
  <info>
    <title>Thesis short-author citations</title>
    <id>urn:uuid:12bd3d5e-f40c-4f51-a8e4-91621dc8e575</id>
    <author><name>Amadeus Beckmann</name></author>
    <category citation-format="numeric"/>
    <summary>Author-only and numeric prose citations for the thesis; not a full bibliography style.</summary>
    <updated>2026-10-07T00:00:00+00:00</updated>
    <rights license="https://opensource.org/license/mit">MIT License

