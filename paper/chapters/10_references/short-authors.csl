  </info>
  <!-- Typst uses this numeric layout for the reference part of prose citations. -->
  <citation>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <!-- Typst extracts authors from this layout for form="author" and form="prose". -->
  <bibliography>
    <layout>
      <names variable="author">
        <name form="short" and="text" delimiter-precedes-last="never" et-al-min="3" et-al-use-first="1"/>
      </names>
    </layout>
  </bibliography>
</style>
